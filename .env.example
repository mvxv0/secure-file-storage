# mongo baza (dize se u dockeru na portu 27017)
MONGO_USER=admin
MONGO_PASSWORD=password
MONGO_URI=mongodb://admin:password@localhost:27017
MONGO_DB_USERS=users_db
MONGO_DB_FILES=files_db

# minio object store (port 9000 api, 9001 konzola - za files servis kasnije)
MINIO_USER=minioadmin
MINIO_PASSWORD=password

# portovi i adrese servisa
# api-gateway se dize na 8080 (ulazna tacka za postman i frontend)
API_GATEWAY_PORT=8080
# users-service se dize na 8081
USERS_SERVICE_PORT=8081
USERS_SERVICE_URL=http://localhost:8081
# ostali servisi (8082 - 8085)
FILES_SERVICE_PORT=8082
FILES_SERVICE_URL=http://localhost:8082
SHARING_SERVICE_PORT=8083
SHARING_SERVICE_URL=http://localhost:8083
NOTIFICATIONS_SERVICE_PORT=8084
NOTIFICATIONS_SERVICE_URL=http://localhost:8084
ANALYTICS_SERVICE_PORT=8085
ANALYTICS_SERVICE_URL=http://localhost:8085

# mailhog smtp (dize se u dockeru: 1025 je smtp port za slanje iz go-a, a 8025 je web inbox u browseru)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@secure-storage.local

# jwt i trajanje tokena (otp vazi 5 min = 300s, reset link 15 min = 900s)
JWT_SECRET=dev-secret-key-promeni-u-produkciji
JWT_EXPIRATION_HOURS=24
OTP_EXPIRATION_SECONDS=300
RESET_TOKEN_EXPIRATION_SECONDS=900

# pravila za sifru (min starost 1 dan = 86400s, max starost 60 dana = 5184000s, lock 5 min = 300s)
MIN_PASSWORD_AGE_SECONDS=86400
MAX_PASSWORD_AGE_SECONDS=5184000
ACCOUNT_LOCK_DURATION_SECONDS=300

# pocetna kvota za novog korisnika (100 MB u bajtovima)
DEFAULT_STORAGE_QUOTA_BYTES=104857600

# url klijentske aplikacije
FRONTEND_URL=http://localhost:5173
